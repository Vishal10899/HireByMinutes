# =============================================================================
# HIREBYMINUTES — FRONTEND ENVIRONMENT CONFIGURATION (VITE)
# =============================================================================
# When running on Render in production, Express serves the built client/dist
# directly on the same origin (hirebyminute.com), making API routing automatic (/api).
# For local development or separated environments, configure this variable:
# Only variables prefixed with VITE_ are exposed to the client browser.
# DO NOT store backend secrets (DB connection, JWT secret, Razorpay secret) here.
# =============================================================================

# The public URL of the backend API (defaults to /api on same-origin production):
VITE_API_BASE_URL=http://localhost:5000/api

# Optional platform branding overrides:
# VITE_PLATFORM_NAME=HireByMinute
