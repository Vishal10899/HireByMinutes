# =============================================================================
# HIREBYMINUTES — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env and configure values for your environment.
# Never commit the actual .env file or real production secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE SERVER & ENVIRONMENT (Required)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required)
# -----------------------------------------------------------------------------
# Long random cryptographic string for signing JWT tokens and session hashes
JWT_SECRET=your-jwt-secret-key-here-minimum-32-chars

# Initial administrator bootstrap account
ADMIN_EMAIL=vishalkumar75912@gmail.com
ADMIN_PASSWORD=1Agust@1999

# -----------------------------------------------------------------------------
# 3. PLATFORM BUSINESS CONFIGURATION (Required)
# -----------------------------------------------------------------------------
PLATFORM_NAME=HireByMinutes
LISTING_FEE_USD=2.00
PLATFORM_FEE_PERCENT=15

# -----------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Default is local embedded SQLite. For multi-server clusters, specify PostgreSQL URL.
DATABASE_URL=./server/hirebyminutes.db

# -----------------------------------------------------------------------------
# 5. PAYMENT GATEWAY INTEGRATION (Required for Live Payments)
# -----------------------------------------------------------------------------
# Stripe / Payment Provider API credentials for real money processing
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (Required for Live Booking Notifications)
# -----------------------------------------------------------------------------
# Resend, SendGrid, Postmark, or standard SMTP
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="HireByMinutes <notifications@hirebyminutes.com>"

# -----------------------------------------------------------------------------
# 7. WEBRTC & TURN/STUN RELAY SERVERS (Required for Reliable Video/Audio)
# -----------------------------------------------------------------------------
# Coturn or Twilio Network Traversal Service credentials for NAT / Firewall bypass
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:turn.yourdomain.com:3478
TURN_USERNAME=turn_user
TURN_CREDENTIAL=turn_password

# -----------------------------------------------------------------------------
# 8. CLOUD OBJECT STORAGE (Optional: Recommended for Multi-Instance Storage)
# -----------------------------------------------------------------------------
# AWS S3, Cloudflare R2, or MinIO for user file uploads outside local filesystem
S3_BUCKET_NAME=hirebyminutes-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# -----------------------------------------------------------------------------
# 9. FRONTEND CLIENT ENVIRONMENT (Client side)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_ENABLE_DEMO_MODE=false
