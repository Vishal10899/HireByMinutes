# =============================================================================
# HIREBYMINUTES — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env and configure values for your environment.
# Never commit the actual .env file or real production secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE SERVER & ENVIRONMENT (Required)
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=
ALLOWED_ORIGINS=
FRONTEND_URL=

# -----------------------------------------------------------------------------
# 2. PERSISTENT DATABASE (Required for Render Free)
# -----------------------------------------------------------------------------
# Remote PostgreSQL connection string (Neon, Supabase, Aiven, or ElephantSQL)
# Example: postgresql://username:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_5huVAgOw7ocD@ep-fancy-frog-ay4krhqt-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Required)
# -----------------------------------------------------------------------------
# 64-character random cryptographic string for signing JWT tokens and hashes
JWT_SECRET=

# Master Administrator Credentials (Initialized securely on startup)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 4. PLATFORM BUSINESS CONFIGURATION (Required)
# -----------------------------------------------------------------------------
PLATFORM_NAME=HireByMinutes
LISTING_FEE_USD=2.00
PLATFORM_FEE_PERCENT=15

# -----------------------------------------------------------------------------
# 5. EXTERNAL OBJECT STORAGE (Required for Render Free Ephemeral Filesystem)
# -----------------------------------------------------------------------------
# S3-compatible cloud storage (Cloudflare R2, AWS S3, Supabase Storage, Backblaze B2)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# -----------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY (Required for Live Payments)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL (HTTPS API-Based for Render Free)
# -----------------------------------------------------------------------------
# Render Free blocks outbound SMTP ports (25/465/587); use HTTPS API (Resend)
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_API_KEY=
EMAIL_FROM=HireByMinutes <no-reply@yourdomain.com>
EMAIL_FROM_NAME=HireByMinutes
EMAIL_REPLY_TO=support@yourdomain.com

# Token & OTP Lifecycles
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EXPIRY_MINUTES=30

# -----------------------------------------------------------------------------
# 8. WEBRTC & TURN/STUN RELAY (Required for NAT/Firewall Audio/Video Traversal)
# -----------------------------------------------------------------------------
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# -----------------------------------------------------------------------------
# 9. FRONTEND ENVIRONMENT CONFIGURATION (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=
VITE_SOCKET_URL=
